{
  "manifest_version": 3,
  "name": "noDelayStream",
  "version": "1.5.3",
  "description": "Velocidad, calidad y volumen del video de la pestaña activa. En vivo reduce el delay sin pelear con el reproductor.",
  "permissions": [
    "activeTab",
    "webNavigation",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "noDelayStream"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
